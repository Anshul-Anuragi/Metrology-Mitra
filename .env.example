# =============================================================================
# MetrologyMitra — Environment Configuration Example (.env.example)
# =============================================================================

# --- Backend Configuration ---
PROJECT_NAME="MetrologyMitra"
ENVIRONMENT="development"
SECRET_KEY="replace_with_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5434
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_dev_password"
POSTGRES_DB="legal_metrology"

# Direct DB URLs (Optional overrides)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres_dev_password@localhost:5434/legal_metrology"
# SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres_dev_password@localhost:5434/legal_metrology"

# --- Frontend Configuration ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"

